<UserControl x:Class="TaskMasterPRO.View.Components.ManagePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskMasterPRO.View.Components"
             mc:Ignorable="d" >
    <Border
        Background="#A3B18A" 
        CornerRadius="15, 0,0,0"
        Padding="5,5,0,0" 
        >
        <StackPanel>
            <StackPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                    <Setter Property="Margin" Value="0,0,0,10"/>
                </Style>
            </StackPanel.Resources>

            <Button
                    Command="{Binding DataContext.ShowAddTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Path 
                    Data="{StaticResource IconTask}" 
                    Fill="Black" 
                    Stretch="Fill" 
                    />
            </Button>

            <Button
                    Command="{Binding DataContext.ShowAddCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <Path 
                    Data="{StaticResource IconCategory}" 
                    Fill="Black" 
                    Stretch="Fill" 
                    />
            </Button>
        </StackPanel>
    </Border>
</UserControl>
