<UserControl x:Class="TaskMasterPRO.View.Components.CategoryAddForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskMasterPRO.View.Components"
             xmlns:domain="clr-namespace:TaskMasterPRO.Data.Domain"
             xmlns:ext="clr-namespace:TaskMasterPRO.Extensions" 
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" 
             Width="200">
    <Border
        Background="#A3B18A" 
        >
        <StackPanel
            Margin="5,5,5,5"
        >
            <TextBlock Text="Add New Category" />

            <TextBox 
            Style="{StaticResource LabeledTextBoxStyle}" 
            Tag="Title" 
            Text="{Binding CategoryToAdd.Name, UpdateSourceTrigger=PropertyChanged}"
            />

            <TextBox 
            Style="{StaticResource LabeledTextBoxStyle}" 
            Tag="Description" 
            Text="{Binding CategoryToAdd.Description, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap" 
            VerticalScrollBarVisibility="Hidden"
            AcceptsReturn="True" 
            Height="200"
            />

            <xctk:ColorPicker 
                SelectedColor="{Binding CategoryToAdd.Color}" 
                DisplayColorAndName="True" 
                AvailableColorsHeader="Colors" 
                />

            <Button Content="Add Category" Command="{Binding AddCategoryCommand}"/>

        </StackPanel>
    </Border>
</UserControl>
