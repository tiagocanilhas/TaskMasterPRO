<UserControl x:Class="TaskMasterPRO.View.Components.TaskAddForm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskMasterPRO.View.Components"
             xmlns:domain="clr-namespace:TaskMasterPRO.Data.Domain"
             xmlns:ext="clr-namespace:TaskMasterPRO.Extensions"
             mc:Ignorable="d" 
             Width="200">
    <Border
        Background="#A3B18A" 
        >
        <StackPanel
            Margin="5,5,5,5"
        >
        <TextBlock Text="Add New Task"/>

        <TextBox 
            Style="{StaticResource LabeledTextBoxStyle}" 
            Tag="Title" 
            Text="{Binding TaskToAdd.Title, UpdateSourceTrigger=PropertyChanged}"
            />


        <TextBox 
            Style="{StaticResource LabeledTextBoxStyle}" 
            Tag="Description" 
            Text="{Binding TaskToAdd.Description, UpdateSourceTrigger=PropertyChanged}"
            TextWrapping="Wrap" 
            VerticalScrollBarVisibility="Hidden"
            AcceptsReturn="True" 
            Height="200"
            />
        
        <DatePicker 
            Style="{StaticResource LabeledDatePickerStyle}" 
            Tag="Deadline" 
            SelectedDate="{Binding TaskToAdd.Deadline, UpdateSourceTrigger=PropertyChanged}"
            />

        <ComboBox 
            Style="{StaticResource LabeledComboBoxStyle}" 
            Tag="Priority"
            ItemsSource="{Binding Source={ext:EnumBinding {x:Type domain:Priority}}}"
            />

        <ComboBox 
            Style="{StaticResource LabeledComboBoxStyle}" 
            Tag="Categories"
            ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=Window}}"
            DisplayMemberPath="Name"
            SelectedValuePath="Id"
            SelectedValue="{Binding TaskToAdd.CategoryId, UpdateSourceTrigger=PropertyChanged}"
            />

        <Button Content="Add Task" Command="{Binding AddTaskCommand}"/>
        </StackPanel>

    </Border>
</UserControl>
